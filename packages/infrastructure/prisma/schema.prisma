generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Workspace.ownerUserId is intentionally a plain column, not a foreign key:
// User -> Workspace is already a required FK (below), and a Workspace ->
// User FK too would make the two tables circularly dependent, which Postgres
// cannot satisfy without deferred constraints. Application code always sets
// it correctly (RegisterUser generates both ids before inserting either
// row); see docs/adr/0004-workspace-isolation-and-migration-process.md.
model Workspace {
  id          String     @id
  name        String
  ownerUserId String
  createdAt   DateTime   @default(now())
  users       User[]
  workflows   Workflow[]
  schedules   Schedule[]

  @@map("workspaces")
}

model User {
  id            String         @id
  email         String         @unique
  passwordHash  String
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@map("refresh_tokens")
}

// Steps are stored as JSON, not a relational table: this release has exactly
// one hardcoded Workflow, seeded via prisma/seed.ts — a full Step table with
// ordering/foreign keys is deferred until workflow authoring is a real
// feature (see docs/adr/0001-foundation-decisions.md's overengineering rule).
model Workflow {
  id          String        @id
  name        String
  steps       Json
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime      @default(now())
  runs        WorkflowRun[]
  schedules   Schedule[]

  @@map("workflows")
}

// Schedule -> Workflow cascades: a deleted Workflow leaves no dangling
// Schedule row. Schedule -> Workspace does not cascade, matching how
// Workflow -> Workspace is modeled (Workspaces are never deleted in this
// release). No BullMQ registration is touched by this cascade — deleting a
// Workflow directly in Postgres does not unregister any Schedule's queue job;
// this release's only supported deletion path for a Schedule is
// DELETE /schedules/:id (see docs/adr/0006-schedule-execution-strategy.md).
model Schedule {
  id             String    @id
  workflowId     String
  workflow       Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  cronExpression String
  createdAt      DateTime  @default(now())

  @@index([workspaceId])
  @@map("schedules")
}

model WorkflowRun {
  id          String                     @id
  workflowId  String
  workflow    Workflow                   @relation(fields: [workflowId], references: [id])
  // Denormalized from workflow.workspaceId — defense in depth so isolation
  // doesn't depend on every query joining through workflows correctly. See
  // ADR-0004.
  workspaceId String
  status      String
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime                   @default(now())
  stepResults WorkflowStepResultRecord[]

  @@map("workflow_runs")
}

model WorkflowStepResultRecord {
  id            String      @id @default(uuid())
  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  stepId        String
  status        String
  output        Json?
  error         String?
  startedAt     DateTime
  finishedAt    DateTime

  @@map("workflow_step_results")
}
