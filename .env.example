# FlowMind AI — environment configuration
#
# Copy this file to `.env` at the repo root and fill in the values you need.
# `pnpm demo` validates the required ones automatically before running.

# ── Required — the app will not boot without these ─────────────────────────

# Postgres connection string. The `docker-compose.yml` at the repo root
# already provisions a matching database — the default value works as-is
# once you run `docker compose up -d`.
DATABASE_URL="postgresql://flowmind:flowmind@localhost:5432/flowmind"

# Redis connection string, used by BullMQ for the workflow-execution queue.
# Also provisioned by `docker-compose.yml` — default works out of the box.
REDIS_URL="redis://localhost:6379"

# ── Optional — the app boots without these; GET /health reports each as ────
# ── "not_configured" until you set it, and the matching workflow step   ────
# ── fails with a clear error instead of crashing the process            ────

# Anthropic API key, used by ClaudeProvider (packages/ai/claude) to call
# Claude for the AI step of the demo workflow. Get one at
# https://console.anthropic.com/ — without it, the AI step fails with
# "AIProvider "CLAUDE" failed to complete the request." and the run is
# recorded as FAILED, which is still useful to see the pipeline working.
ANTHROPIC_API_KEY="sk-ant-replace-me"

# Slack bot token with the chat:write scope, used by SlackDestination
# (packages/destinations/slack) to post the workflow's result. Create one at
# https://api.slack.com/apps — without it, the Destination step fails the
# same way the AI step does when unconfigured.
SLACK_BOT_TOKEN="xoxb-replace-me"

# Slack channel the seeded demo workflow posts to (must start with #, and
# the bot must be invited to it). Only read by the seed script
# (packages/infrastructure/prisma/seed.ts) — defaults to #alerts if unset.
SLACK_CHANNEL="#alerts"

# ── Authentication (v0.4.0) ────────────────────────────────────────────────

# HS256 signing key for the 15-minute access token. Minimum 32 characters.
# The API refuses to boot with NODE_ENV=production while this is still the
# development default below — generate a real one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET="dev-only-insecure-access-token-secret-change-me"

# Access token lifetime (a `jose` duration string). 15 minutes per ADR-0003 —
# short, because the token is not revocable before it expires.
ACCESS_TOKEN_TTL="15m"

# Refresh token / refresh cookie lifetime, in days. The refresh token rotates
# on every use, so this bounds an idle session, not an active one.
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated CORS allow-list for the API. Must name the frontend origin
# exactly: the refresh cookie is credentialed, so `*`/reflect-any is not an
# option (PRD v0.4.0).
WEB_ORIGIN="http://localhost:3000"

# ── Optional — have sensible defaults, rarely need changing ────────────────

# Port the Fastify API listens on.
PORT=3001

# Base URL the visual editor (apps/web) calls for the API. Read at build/dev
# time by Next.js (must be prefixed NEXT_PUBLIC_ to reach the browser).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# development | test | production
NODE_ENV=development
